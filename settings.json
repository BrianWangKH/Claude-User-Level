{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "permissions": {
    "allow": [
      "Edit(./plans/tests/**)",
      "Bash(bash ~/.claude/skills/feature-flow/verify-untouched.sh *)",
      "Bash(bash ~/.claude/skills/new-worktree/new-worktree.sh *)",
      "Bash(bash ~/.claude/skills/finish-worktree/finish-worktree.sh *)",
      "Bash(python3 ~/.claude/skills/repo-plan/cost-history.py add *)",
      "Bash(python3 ~/.claude/skills/repo-plan/cost-history.py estimate *)",
      "Bash(python3 ~/.claude/skills/repo-plan/cost-history.py snapshot *)",
      "Bash(python3 ~/.claude/skills/repo-plan/cost-history.py bias *)",
      "Bash(python3 ~/.claude/skills/repo-plan/worker-status.py *)"
    ],
    "deny": [
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(//mnt/**)",
      "Edit(//etc/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.mcp.json)",
      "Edit(./.hook-only/**)",
      "Edit(./.claude/agents/**)",
      "Read(./.hook-only/hook-read-only/**)",
      "mcp__*"
    ],
    "ask": [
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "../worktrees/"
    ],
    "useAutoModeDuringPlan": false,
    "_commented_disableAutoMode": "disable"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hook-entry.py pre",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/budget/worker-progress.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3 ~/.claude/hooks/gates/crap-gate.py",
            "timeout": 2700,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(mutate-request *)",
            "command": "python3 ~/.claude/hooks/gates/mutation.py",
            "timeout": 2700
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hook-entry.py handback",
            "timeout": 5400
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hook-entry.py start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hook-entry.py stop",
            "timeout": 5400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hook-entry.py prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|SendMessage|SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/hook-entry.py post"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python3 ~/.claude/hooks/worker/flow-next.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/repo-plan/repo-check.py --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/worker/worker-stop.py"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com"
      ],
      "strictAllowlist": false
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude/docs",
        "~/go",
        "~/.cache/go-build",
        "~/.cache/uv"
      ],
      "denyWrite": [
        "/mnt",
        "~/**/plans",
        "~/godot",
        "~/**/.hook-only"
      ],
      "denyRead": [
        "/mnt",
        "/run/user/1000",
        "/run/WSL",
        "~/**/plans",
        "~/**/.hook-only/hook-read-only"
      ],
      "allowRead": [
        "~/.gitconfig",
        "~/.config/git/ignore",
        "~/.claude/docs",
        "~/godot",
        "~/.claude/templates",
        "~/.claude/README.md",
        "~/.claude/CLAUDE.md",
        "~/go",
        "~/.cache/go-build",
        "~/.local/bin",
        "~/.cache/uv",
        "~/.claude/config"
      ]
    }
  },
  "effortLevel": "medium",
  "maxEffortLevel": "medium",
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Per-Command Network Hosts: block any shell command (Bash, PowerShell, Monitor) whose tool input includes a non-empty `allowed_domains` field, regardless of the host (including package registries, the git remote host, or hosts the user mentioned in chat); the Command Network Lists exemptions do not apply. Hostnames that merely appear in the command text (e.g. a `curl` URL) are not a match, and an empty `allowed_domains` is not a match. Non-shell tools (WebFetch, MCP) are intentionally out of scope. Network access must come only from the sandbox `allowedDomains` in settings; the block reason should tell the user to add the host there rather than approving it per command."
    ]
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/wt-pane"
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/hooks/budget/quota-snapshot.py"
  },
  "feedbackDrafts": "off"
}