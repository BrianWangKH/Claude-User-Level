# Whitelist: ignore everything, then allow config only
/*
!/.gitignore
!/CLAUDE.md
!/settings.json
!/agents/
!/skills/
!/hooks/
!/commands/
!/docs/
!/templates/
!/mods/
__pycache__/
/skills/synced/
/skills/.trash/
!/README.md
!/README.zh-TW.md
!/config/
# config/local.json, local.test.json and mode: the person's overrides and config mode, never tracked
# (config/.gitignore says the same)
/config/local.json
/config/local.test.json
/config/mode
